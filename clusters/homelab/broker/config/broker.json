{
  "listen": "0.0.0.0:8080",
  "deny_addresses": [],
  "github_app": {"key_secret": "github-app-private-key", "id_secret": "github-app-id"},
  "logical_hosts": {
    "neuralwatt": {
      "scheme": "https",
      "host": "api.neuralwatt.com",
      "port": 443,
      "allow_private": false,
      "secret": "neuralwatt-api-key",
      "inject": {
        "kind": "bearer"
      }
    },
    "github-apps": {
      "scheme": "https",
      "host": "github.com",
      "port": 443,
      "allow_private": false,
      "github_app": {
        "installation": "github-apps-installation-id",
        "repositories": ["homelabs-apps"],
        "permissions": {
          "contents": "write"
        }
      },
      "inject": {
        "kind": "basic",
        "username": "x-access-token"
      }
    },
    "github-platform-push": {
      "scheme": "https",
      "host": "github.com",
      "port": 443,
      "allow_private": false,
      "github_app": {
        "installation": "github-platform-installation-id",
        "repositories": ["homelabs-platform"],
        "permissions": {
          "contents": "write"
        }
      },
      "inject": {
        "kind": "basic",
        "username": "x-access-token"
      }
    },
    "github-platform": {
      "scheme": "https",
      "host": "api.github.com",
      "port": 443,
      "allow_private": false,
      "github_app": {
        "installation": "github-platform-installation-id",
        "repositories": ["homelabs-platform"],
        "permissions": {
          "contents": "read",
          "pull_requests": "write"
        }
      },
      "inject": {
        "kind": "bearer"
      }
    },
    "tinyfish": {
      "scheme": "https",
      "host": "api.search.tinyfish.ai",
      "port": 443,
      "allow_private": false,
      "secret": "tinyfish-api-key",
      "inject": {
        "kind": "header",
        "header": "X-Api-Key"
      }
    },
    "loki": {
      "scheme": "http",
      "host": "loki-gateway.observability.svc.cluster.local",
      "port": 3100,
      "allow_private": true,
      "secret": "loki-gateway-token",
      "inject": {
        "kind": "bearer"
      },
      "headers": {
        "X-Scope-OrgID": "data"
      }
    },
    "status": {
      "scheme": "http",
      "host": "status-exporter.observability.svc.cluster.local",
      "port": 9101,
      "allow_private": true
    }
  }
}
