[Unit]
{% set snapshot_mounts = (zfs_datasets | map(attribute='mountpoint') | list) + (backup_mounts | map(attribute='path') | list) %}
{% for group_id in backup_pending_host_groups %}
{% for member in backup_group_specs[group_id].members %}
{% set _ = snapshot_mounts.append(member.mount) %}
{% endfor %}
{% endfor %}
Description={{ snapshot_description }}
Wants=network-online.target
After=network-online.target
Requires=zfs-mount.service
After=zfs-mount.service
{% for unit in backup_crypt_units %}
Requires={{ unit }}
After={{ unit }}
{% endfor %}
RequiresMountsFor={{ snapshot_mounts | unique | join(' ') }}
{% for mount in snapshot_mounts | unique %}
AssertPathIsMountPoint={{ mount }}
{% endfor %}

[Service]
Type=oneshot
User=root
Group=root
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=RESTIC_CACHE_DIR=/var/cache/restic-backup
ExecStart={{ backup_python }} {{ backup_snapshotter }} --config {{ backup_config_file }}{{ snapshot_exec_args }}
TimeoutStartSec={{ backup_service_timeout }}
UMask=0077
# The snapshot must be readable by every destination before writers resume;
# the controller resumes them in a finally block, so a failed destination never
# leaves a writer fenced and never publishes a partial generation.
# ZFS needs /dev/zfs, so devices are not privatised; everything else is.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths={{ backup_manifest_dir }} /var/cache/restic-backup
{% for mount in backup_mounts %}
ReadWritePaths={{ mount.path }}
{% endfor %}
StandardOutput=journal
StandardError=journal
